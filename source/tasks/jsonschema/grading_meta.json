  "suite_repo": "https://github.com/json-schema-org/JSON-Schema-Test-Suite",
  "commit_rule": "the commit at the tip of the default branch (main) of json-schema-org/JSON-Schema-Test-Suite at preparation time, read with git ls-remote; pinned below as suite_commit",
  "files_rule": "tests/draft2020-12/*.json, top-level files only (the optional/ directory is not used), excluding refRemote.json",
  "exclusion_rule": "a test group (one top-level array entry of a file) is excluded when json.dumps(group) contains 'localhost:1234', or when any '$ref' or '$dynamicRef' value anywhere in its schema (recursive walk over dicts and lists) is a string starting with 'https://json-schema.org/'",
  "split_rule": "per file, keep the remaining groups in file order, then random.Random('20261022:' + file_name).shuffle(list_of_group_indices); the first ceil(n/2) shuffled indices are visible, the rest hidden. A test case is one entry of a group's 'tests' list; scores count test cases.",
